# GitHub Capability & Security Sentinel — copy to .env and fill in.
# Every setting shared/config.py reads, with its default.
GITHUB_TOKEN=
DB_PATH=sentinel.db
REPO_CACHE_DIR=/tmp/repo_cache
VAULT_DIR=vault
OLLAMA_HOST=http://localhost:11434
SYNTHESIS_MODEL=qwen2.5-coder:3b
SECURITY_MODEL=phi3:mini
MIN_STARS=1000
SEARCH_KEYWORDS=ai agent, harness, autonomous, llm framework
POLL_INTERVAL_SEC=300
LLM_TIMEOUT_SEC=120
CONTEXT_BUDGET_TOKENS=6000
AST_SUMMARY=1
